<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- serve index.asp / default.asp when a folder is requested -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.asp" />
        <add value="default.asp" />
      </files>
    </defaultDocument>
    <!-- show the real Classic ASP error text instead of a bare 500 page -->
    <asp scriptErrorSentToBrowser="true" />
    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
